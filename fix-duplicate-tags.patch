+/**
+ * Tags like R-014 / HH-007 are auto-numbered in the browser from the data it
+ * last loaded, but (project_id, tag) is UNIQUE in the database. Anything that
+ * makes the browser's copy stale — a second tab, a refresh that hadn't landed
+ * yet, another user on the same project — produces a tag that already exists
+ * and the insert is rejected outright ("duplicate key value violates unique
+ * constraint"), losing the route the user just drew.
+ *
+ * So the tag is resolved here, against live data, and the caller's tag is only
+ * a preference. Returns the first free `PREFIX-NNN`.
+ */
+async function nextFreeTag(
+  supabase: Awaited<ReturnType<typeof createClient>>,
+  table: 'fiber_routes' | 'fiber_nodes',
+  column: 'route_id_tag' | 'node_tag',
+  projectId: string,
+  preferredTag: string
+): Promise<string> {
+  const { data } = await supabase.from(table).select(column).eq('project_id', projectId)
+  // table/column are dynamic, so the generated row union can't resolve here —
+  // read the rows as plain records.
+  const rows = (data ?? []) as unknown as Record<string, unknown>[]
+  const taken = new Set(rows.map(row => String(row[column])))
+  if (!taken.has(preferredTag)) return preferredTag
+
+  // Keep the caller's prefix (R-, HH-, CE-…) and find the next free number.
+  const dash = preferredTag.lastIndexOf('-')
+  const prefix = dash > 0 ? preferredTag.slice(0, dash) : preferredTag
+  let max = 0
+  for (const tag of taken) {
+    if (!tag.startsWith(`${prefix}-`)) continue
+    const num = parseInt(tag.slice(prefix.length + 1), 10)
+    if (!isNaN(num) && num > max) max = num
+  }
+  let candidate = ''
+  for (let n = max + 1; n < max + 500; n++) {
+    candidate = `${prefix}-${String(n).padStart(3, '0')}`
+    if (!taken.has(candidate)) break
+  }
+  return candidate
+}
+
+/** Postgres unique-violation. */
+function isDuplicateTagError(err: { code?: string } | null): boolean {
+  return err?.code === '23505'
+}
