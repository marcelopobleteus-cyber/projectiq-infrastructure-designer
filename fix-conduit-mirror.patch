+      // reporting a clean success over a half-finished write.
+      showNotification('error', res.warning)
+      setToolMode('select')
+      await loadDesignData()
     } else {
       showNotification(
         'success',
@@ -1290,6 +1296,13 @@ export default function FiberMapCanvas({
 
     if (res.error) {
       showNotification('error', res.error)
+    } else if (res.warning) {
